rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Colección de usuarios (/users/{uid})
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if (
        isOwner(uid) &&
        request.resource.data.get('username', '') == resource.data.get('username', '') &&
        request.resource.data.get('usernameNormalized', '') == resource.data.get('usernameNormalized', '')
      ) || (
        isAuthenticated() &&
        resource.data.partnerId == request.auth.uid &&
        request.resource.data.get('username', '') == resource.data.get('username', '') &&
        request.resource.data.get('usernameNormalized', '') == resource.data.get('usernameNormalized', '')
      );
      allow delete: if false;
    }

    // 2. Reserva de nombres de usuario (/usernames/{usernameNormalized})
    match /usernames/{usernameNormalized} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Los cambios de username se realizan únicamente mediante Cloud Functions.
      allow update: if false;
      // Solo una reserva de un registro todavía incompleto puede liberarse desde el cliente.
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 3. Progreso en Solitario (/solo_progress/{uid})
    match /solo_progress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 4. Progreso y Contrato de Pareja (/couples_progress/{coupleId})
    match /couples_progress/{coupleId} {
      allow read: if isAuthenticated();
      
      allow create, update: if isAuthenticated() && (
        request.resource.data.get('user1Id', null) == request.auth.uid ||
        request.resource.data.get('user2Id', null) == request.auth.uid ||
        request.resource.data.get('user1', null) == request.auth.uid ||
        request.resource.data.get('user2', null) == request.auth.uid
      );
        
      allow delete: if isAuthenticated() && (
        resource.data.get('user1Id', null) == request.auth.uid ||
        resource.data.get('user2Id', null) == request.auth.uid ||
        resource.data.get('user1', null) == request.auth.uid ||
        resource.data.get('user2', null) == request.auth.uid
      );
    }

    // 5. Catálogo de Aventuras (/adventures/{adventureId})
    match /adventures/{adventureId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo por admin / seeder
    }

    // 6. Recuerdos Individuales (/solo_memories/{memoryId})
    match /solo_memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 7. Recuerdos de Pareja (/memories/{memoryId})
    match /memories/{memoryId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Grupos y Lobbies (/groups/{groupCode})
    match /groups/{groupCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 9. Recuerdos Grupales (/group_memories/{memoryId})
    match /group_memories/{memoryId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Colecciones exclusivas de servidor (Admin SDK via Cloud Functions)
    match /pairInvites/{code} {
      allow read, write: if false;
    }

    match /pairInviteOwners/{uid} {
      allow read, write: if false;
    }

    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }
  }
}
